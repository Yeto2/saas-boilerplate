NODE_ENV=development
PORT=4020
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
DATABASE_FILE=./data/saas.sqlite

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Stripe is optional. Leave STRIPE_SECRET_KEY unset to run in self-contained
# dev mode (checkout/portal return local URLs; webhooks can be simulated).
# STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_dev_local_secret
STRIPE_PRICE_PRO=price_dev_pro
APP_BASE_URL=http://localhost:3000
